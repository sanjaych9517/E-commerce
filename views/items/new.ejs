<% layout("/layouts/boilerplate") %>
    <h3>Add a New Item</h3>

    <form action="/items" method="post">
      <input name="item[title]" placeholder="enter title" type="text" />
      <br /><br />
      <textarea
        name="item[description]"
        placeholder="enter description"
        type="text"
      ></textarea>
      <br /><br />
      <input name="item[image]" placeholder="enter image URL/Link" type="text" />
      <br /><br />
      <input name="item[price]" placeholder="enter price" type="number" />
      <br /><br />
      <input name="item[category]" placeholder="enter category" type="text" />
      <br /><br />
      <input name="item[brand]" placeholder="enter brand" type="text" />
      <br /><br />
      <input name="item[stock]" placeholder="enter stock" type="number" />
      <br /><br />
      <button>Add</button>
    </form>
  </body>

