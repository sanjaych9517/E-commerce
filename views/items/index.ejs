<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E - Commerce</title>
</head>
<body>
    <h3>All Items</h3>

    <ol>
    <% for(let item of allItems){  %>
        <li>
            <a href="/items/<%= item._id %>"> <%= item.title %></a>
        </li>
   <% } %>
</ol>

</body>
</html>

