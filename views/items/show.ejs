<% layout("/layouts/boilerplate") %>

  <div class="row mt-3">
    <div class="col-8 offset-3 mt-4 mb-2">
      <h3>
        <%= item.title %>
      </h3>
    </div>
    <div class="card col-8 offset-2 show-card listing-card ">
      <img src="<%= item.image %>" class="card-img-top show-img mt-4" alt="item_image" />
      <div class="card-body">
        <p class="card-text">
          <i>
            Owned by this Product :<b>
              <%= item.owner ? item.owner.username : "Unknown User" %>
            </b><br>

            <%= item.title %>
              <br>

              <%= item.description %>
                <br>
                &#8377; <%= (item.price ?? 0).toLocaleString("en-IN") %>
                  <br>

                  <%= item.category %>
                    <br>

                    <%= item.brand %> <br>
                      Number of component: <%= item.stock %>

          </i>
        </p>
      </div>
    </div>
    <!-- for authentication user and edit button -->
    <% if(currentUser && currentUser._id.equals(item.owner._id)) { %>
      <div class="btns">
        <a href="/items/<%= item._id%>/edit" class="btn btn-danger  offset-3 edit mt-4">Edit</a>

        <form method="POST" action="/items/<%= item._id %>?_method=DELETE">
          <button class="btn btn-dark offset-4 delete mt-4">Delete </button>
        </form>
      </div>
      <% } %>
        <!-- for review  -->
        <div class="col-8 offset-2 mt-2 mb-2">
          <hr>
          <h4>Leave a review</h4>
          <!-- for rating -->
          <form action="/items/<%= item.id %>/reviews" method="POST" novalidate 
            class="needs-validation">
            <!-- <div class="mb-3 mt-3">
              <label for="ratinng" class="form-label">Rating : </label>
              <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
            </div> -->

            <!-- for rating start code -->

            <div class="mb-3 mt-3">
              <label for="rating" class="form-level">Rating</label>
              <fieldset class="starability-slot">

                <!-- <legend>First rating:</legend> -->
                <input 
                type="radio" 
                id="no-rate" 
                class="input-no-rate" 
                name="review[rating]" 
                value="1" 
                checked
                  aria-label="No rating."
                />

                <input 
                type="radio" 
                id="first-rate1" 
                name="review[rating]" 
                value="1" 
                />

                <label  for="first-rate1"title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />

                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />

                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />

                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>

            <!-- for rating end code -->

            <!-- for comment -->

            <div class="mb-3 mt-3">
              <label for="comment" class="form-label">Comments : </label>
              <textarea id="commment" cols="20" rows="3" name="review[comment]" class="form-control"
                required></textarea>
              <div class="invalid-feedback">please add some comment for review</div>
            </div>
            <button class=" btn btn-dark add-btn " type="submit">Add Review</button>

          </form>

        </div>
        <!-- for seew comment -->

        <div class="row justify-content-center col-8 offset-2">
          <hr>
          <p><b>All Review</b></p>
          <% for(review of item.reviews) { %>
            <div class="card col-11 col-sm-10 col-md-5 mx-2 mb-4 p-0">

              <div class="card-body p-3 p-md-4">

                <h5 class="card-title mb-3">
                  <i>@<%= review.author.username %></i>
                </h5>

                <p class="starability-result card-text" data-rating="<%= review.rating %>">
                </p>

                <p class="card-text mb-3 text-wrap">
                  <i>
                    <%= review.comment %>
                  </i>
                </p>

                

                <p class="card-text mb-0">
                  <i>
                    <%= review.createdAt.toLocaleString("en-IN", { dateStyle: "short" , timeStyle: "short" }) %>
                  </i>
                </p>

              </div>
              <!-- delete button show only author or product owner -->

              <div class="d-flex justify-content-end p-3">
                <% if ( currentUser && ( review.author._id.equals(currentUser._id) ||
                  item.owner._id.equals(currentUser._id) ) ) { %>
                  <form action="/items/<%= item._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">

                    <button class="btn btn-dark px-4 py-2 delete">
                      Delete
                    </button>
                  </form>
                  <% } %>
              </div>

            </div>
            <% } %>
        </div>

  </div>
  </div>