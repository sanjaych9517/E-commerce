<% layout("/layouts/boilerplate") %>
<body>
    <h3>Items details</h3>
    <ul>
      <li><%= item.title %></li>
      <li><%= item.description %></li>
      <li>&#8377; <%= item.price.toLocaleString("en-IN") %></li>
      <li><%= item.category %></li>
      <li><%= item.brand %></li>
      <li><%= item.stock %></li>
    </ul>
    <br />
    <a href="/items/<%= item._id%>/edit">Edit this item</a>
    <br /><br />
    <form method="POST" action="/items/<%= item._id %>?_method=DELETE">
      <button>Delete fhis item</button>
    </form>
  </body>