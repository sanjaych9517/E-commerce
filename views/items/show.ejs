<% layout("/layouts/boilerplate") %>

  <div class="row mt-3">
    <div class="col-8 offset-3 mt-4 mb-2">
      <h3 ><%= item.title %>:</h3>
    </div>
    <div class="card col-6 offset-3 show-card">
      <img src="<%= item.image %>" class="card-img-top show-img mt-4" alt="item_image" />
      <div class="card-body">
        <p class="card-text">
          <%= item.description %> <br>
            &#8377; <%= (item.price ?? 0).toLocaleString("en-IN") %> <br>
              <%= item.category %> <br>
                <%= item.brand %> <br>
                  Number of component: <%= item.stock %>
                    </i>
        </p>
      </div>
    </div>

    <div class="btns">
      <a href="/items/<%= item._id%>/edit" class="btn btn-danger  offset-3 edit">Edit</a>

      <form method="POST" action="/items/<%= item._id %>?_method=DELETE">
        <button class="btn btn-dark offset-4 delete">Delete </button>
      </form>
    </div>

    <!-- for review  -->
     <div class="col-8 offset-3 mt-4 mb-2">
       <hr>
      <h4>Leave a review</h4>
      <!-- for rating -->
       <form action="/items/<%= item.id %>/reviews" method="POST">
        <div class="mb-3 mt-3">
          <label for="ratinng" class="form-label">Rating : </label>
          <input type="range" min="1" max="7" id="rating" name="review[rating]" 
          class="form-range">
        </div>

        <!-- for comment -->
         <div class="mb-3 mt-3">
          <label for="comment" class="form-label">Comments : </label>
          <textarea id="commment" 
          cols="20" rows="3"
           name="review[comment]"
          class="form-control"></textarea>
         </div>
         <button 
         class=" btn btn-dark add-btn mt-4 pb-3" type="submit">Add Review</button>
      </form>
     </div>
  </div>