<% layout("/layouts/boilerplate") %>

  <div class="row">
    <div class="col-8 offset-3 mt-4 mb-2">
      <h3 >Item Details :</h3>
    </div>
    <div class="card col-6 offset-3 show-card">
      <img src="<%= item.image %>" class="card-img-top show-img mt-4" alt="item_image" />
      <div class="card-body">
        <p class="card-text">
          <b><i>
              <%= item.title %></b><br>
          <%= item.description %> <br>
            &#8377; <%= (item.price ?? 0).toLocaleString("en-IN") %> <br>
              <%= item.category %> <br>
                <%= item.brand %> <br>
                  Number of component: <%= item.stock %>
                    </i>
        </p>
      </div>
    </div>

    <div class="btns">
      <a href="/items/<%= item._id%>/edit" class="btn btn-danger  offset-3 edit">Edit</a>

      <form method="POST" action="/items/<%= item._id %>?_method=DELETE">
        <button class="btn btn-dark offset-4 delete">Delete </button>
      </form>
    </div>
  </div>