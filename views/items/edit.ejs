<% layout("/layouts/boilerplate") %>
  <body>
    <h3>Edit your item</h3>
    <form method="POST" action="/items/<%= item._id %>?_method=PUT">
      <input name="item[title]" value="<%= item.title %>" type="text" />
      <br /><br />
      <textarea name="item[description]"><%= item.description %>
       </textarea>
      <br /><br />
      <input name="item[image]" value="<%= item.image %>" type="text" />
      <br /><br />
      <input name="item[price]" value="<%= item.price %>" type="number" />
      <br /><br />
      <input name="item[category]" value="<%= item.category %>" type="text" />
      <br /><br />
      <input name="item[brand]" value="<%= item.brand %>" type="text" />
      <br /><br />
      <input name="item[stock]" value="<%= item.stock %>" type="number" />
      <br /><br />
      <button>Edit</button>
    </form>
  </body>

